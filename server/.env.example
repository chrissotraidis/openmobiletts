# Open Mobile TTS Server Configuration
# Copy to .env and customize as needed. All settings have sensible defaults.

# TTS Engine Selection: 'kokoro' (PyTorch, default) or 'sherpa-onnx' (ONNX)
TTS_ENGINE=kokoro

# Kokoro PyTorch Settings
KOKORO_LANG_CODE=a
DEFAULT_VOICE=af_heart
DEFAULT_SPEED=1.0
MAX_CHUNK_TOKENS=250

# Sherpa-ONNX Settings (only used when TTS_ENGINE=sherpa-onnx)
# SHERPA_MODEL_DIR=~/.cache/sherpa-onnx-kokoro/kokoro-multi-lang-v1_0
# SHERPA_NUM_THREADS=2

# Audio Encoding Settings
MP3_BITRATE=64k
MP3_SAMPLE_RATE=22050

# Server Settings
HOST=127.0.0.1
PORT=8000
WORKERS=1
# For a deliberate LAN setup, set HOST=0.0.0.0 and list the web origin(s),
# or use CORS_ORIGINS=* only on a trusted network.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Raw document/transcript previews are redacted from logs by default.
LOG_CONTENT_PREVIEWS=false

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/tmp/openmobiletts_uploads

# Optional desktop STT cache root (model installs in a named subdirectory)
# STT_MODEL_CACHE_DIR=~/.cache
